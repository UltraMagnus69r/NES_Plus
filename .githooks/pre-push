#!/bin/sh
# Check files added by commits this push introduces.
# GitHub Actions scans the whole tree, including files already on the remote.
# session-start.sh copies this file to .git/hooks/pre-push.
set -eu
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    commits=$(git rev-list "$local_sha" --not --remotes=origin)
    if [ -z "$commits" ]; then
        continue
    fi
    files=$(printf '%s\n' "$commits" | xargs git diff-tree --no-commit-id --name-only -r --diff-filter=ACMRT | sort -u)
    if [ -z "$files" ]; then
        continue
    fi
    # shellcheck disable=SC2086
    "$ROOT/scripts/check-repository-safety.sh" --files $files || status=1
done
exit "$status"
